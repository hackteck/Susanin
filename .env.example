# Every value here has a working default — the API boots with no configuration.

# Where the API listens (local / self-hosted only; Vercel sets this itself).
PORT=8787

# Browsers allowed to call the API cross-origin. Same-origin deployments
# (frontend and API behind one domain, which is how this ships) need none, so
# the sane thing is to leave this UNSET and keep the built-in defaults.
#
# Setting it REPLACES them rather than adding to them — and the defaults are
# what let the packaged Android app reach the API at all, since Capacitor serves
# the bundle from https://localhost and is therefore cross-origin. If you set
# this, carry those two entries across or the APK goes blank.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5273,http://localhost:4173,https://localhost,capacitor://localhost

# The Batumi feed's origin. The only reason to change it is the emergency
# fallback described in CLAUDE.md:
#   UPSTREAM_BASE=https://bus-proxy.raf003771.workers.dev
UPSTREAM_BASE=https://thetamaps.site:54321

# Upstream request budget, milliseconds. The dataset is 1.27 MB uncompressed,
# so this is not as generous as it looks.
UPSTREAM_TIMEOUT_MS=15000

# Cache lifetimes. These mirror what upstream itself asks for
# (`max-age=600` on the dataset, `max-age=4` on positions) — polling faster
# than the source updates only costs someone else's bandwidth.
DATASET_TTL_MS=600000
VEHICLES_TTL_MS=4000
